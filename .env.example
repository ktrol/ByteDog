DISCORD_TOKEN=your-bot-token

# Decision engine
SCORE_THRESHOLD=50
HASH_MAX_DISTANCE=6
AUTO_LEARN=true
# Max points the learned model can add (40 = it can't flag a message alone, only push borderline ones over)
ML_MAX_POINTS=40
# Fraction of clean messages saved as "normal" examples so the model learns your server's chat
HAM_SAMPLE_RATE=0.02
# Learn from bans: a banned user's suspicious images from the last hour become known scams
LEARN_FROM_BANS=true
# Community reports: this many members reacting with the emoji sends an image to moderators for review
REPORT_EMOJI=🚩
REPORT_THRESHOLD=3

# Actions on a detected scam, comma separated: delete,log,warn,timeout,jail
ACTIONS=delete,log,warn,timeout
TIMEOUT_MINUTES=60
LOG_CHANNEL_ID=0
JAIL_ROLE_ID=0
